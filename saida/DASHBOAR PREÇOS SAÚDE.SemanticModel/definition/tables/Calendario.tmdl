	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2020,1,1),
				        DATE(2026,12,31)
				    ),
				    "Ano", YEAR([Date]),
				    "MesNumero", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "MesAno", FORMAT([Date], "MM/yyyy"),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "Dia", DAY([Date]),
				    "DiaSemana", FORMAT([Date], "dddd"),
				    "NumeroSemana", WEEKNUM([Date]),
				    "AnoMes", YEAR([Date]) * 100 + MONTH([Date])
				)

	annotation PBI_Id = d154500725f841b99696e2f4100a2de0

